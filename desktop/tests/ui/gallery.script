# Slider: click sets, double-click resets, arrow nudges; segmented switches; header toggles.
click:gallerySlider@0.75,0.5
wait:200
expect:gallerySlider.value=75
dclick:gallerySlider@0.75,0.5
wait:200
expect:gallerySlider.value=50
click:gallerySlider@0.5,0.5
key:16777236
wait:150
expect:gallerySlider.value=51
click:gallerySegmented@0.85,0.5
wait:150
expect:gallerySegmented.currentIndex=2
click:galleryHeader@0.2,0.5
wait:150
expect:galleryHeader.open=false
# After a drag, an outside change to the row must still move the knob (I2).
click:gallerySlider@0.75,0.5
wait:150
expect:gallerySlider.value=75
click:galleryExternalReset@0.5,0.5
wait:150
expect:gallerySlider.value=50
# Section header is controlled: an outside change to its open state still shows.
click:galleryOpenHeader@0.5,0.5
wait:150
expect:galleryHeader.open=true
# Switch is controlled by its owner.
click:gallerySwitch@0.9,0.5
wait:150
expect:gallerySwitch.checked=true
# An engine-bound slider writes the control and follows outside changes.
click:slider_film_contrast@0.75,0.5
wait:150
expect:engine.filmControls.film_contrast=150
control:film_contrast=100
wait:150
expect:slider_film_contrast.value=100
expect:ctl_film_contrast.edited=false
shot:${TEMP}/gallery.png
quit
